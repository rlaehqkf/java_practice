<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
 
<%@ page import="com.kh.el.model.dto.Person" %>
    
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>초강력 JSP</title>
</head>
<body>

	<h1>EL구문 배워보기 정말 조아용</h1>
	
	<%-- 
	  
	<%
		String classRoom = (String)request.getAttribute("classRoom");
		Person student = (Person)request.getAttribute("student");
		
		String academy = (String)session.getAttribute("academy");
		Person lecture = (Person)session.getAttribute("lecture");
	%>
	
	<p>
		학원명 : <%= academy %> <br>
		강의장 : <%= classRoom %> <br>
		강사정보 : <%= lecture.getName() %>, <%= lecture.getAge() %>, <%= lecture.getAdress() %> <br><br>
		
		수강생의 정보
		<ul>
			<li> 이름 : <%= student.getName() %></li>
			<li> 나이 : <%= student.getAge() %></li>
			<li> 주소 : <%= student.getAdress() %></li>
		</ul>
	</p>
	--%>

	<h3>EL구문을 이용해서 request / session에 담긴 값들을 출력</h3>
	
	<p>
		학원명 : ${ academy } <br>
		강의장 : ${ classRoom } <br>
		강사정보 : ${ lecture.name } , ${ lecture.age } , ${ lecture.address } <br>
					<!-- getName() -->
					
					
					
		<!-- 
			실제로 필드에 직접 접근하는 것은 불가능 
			.name => getName()
			내부적으로 getter메소드를 찾아서 호출하는 값을 출력하는 구조
		-->			
	</p>

	<hr>
	
	<p>없는 키값을 출력하는 경우</p>

	<p>출력식 : <%= request.getAttribute("clasRoom") %> </p>
	<p>EL구문 : ${ clasRoom }</p>

	<h3>동일한 key값일 경우</h3>
	
	키 : ${ key }

	<%
		// page Scope 에 추가
		pageContext.setAttribute("key", "PageKey");
	%>

	다시 출력해 보기 : ${ key } <br>
	
	<!-- 
	
		EL구문은 가장 적은 범위의 scope부터 키값을 찾음
		page => request => session => application순으로 키 값을 검색
		
		모든 영역을 다 찾았는데 키가 존재하지 않는다? => 아무일도 일어나지 않음 오류 안남
	 -->
	
	pageScope에 값이 담겨있는데, 다른 Scope값을 출력하고 싶은데?? <br>
	
	==> Scope에 직접 접근하기 <br><br>
	
	requestScope : ${ key } <br>
	sessionScope : ${ key } <br>
	applicationScope : ${ key } <br>
	
	
	
	
	




</body>
</html>